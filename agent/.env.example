# Copy to .env and fill in. Keys stay server-side; never ship them to a client.

# Which provider to use: openrouter (default) or groq.
# Switching providers should need no change beyond this file.
LLM_PROVIDER=openrouter

# --- OpenRouter ---
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Must start with "openrouter/" so LiteLLM routes it correctly.
# Browse valid ids at https://openrouter.ai/models
#
# Free models are throttled by whoever hosts them, independently of your own
# OpenRouter quota, so a model that worked last week can start refusing. These
# three were verified working; swap between them if one begins to 429.
OPENROUTER_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free
# openrouter/baidu/ernie-5.5-flash-preview:free
# openrouter/particle-ai/particle-1:free

# --- Groq ---
# Key: https://console.groq.com/keys
GROQ_API_KEY=
# Must start with "groq/".
GROQ_MODEL=groq/llama-3.3-70b-versatile

# --- Server ---
A2A_HOST=127.0.0.1
A2A_PORT=8001

# --- Catalogue (optional) ---
# Folder holding exactly one product-catalogue PDF.
# CATALOG_DIR=catalog
# Maximum characters of extracted PDF text allowed into the model context.
# Startup fails clearly if the catalogue exceeds this.
# MAX_CATALOG_CHARS=120000
